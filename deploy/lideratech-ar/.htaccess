# Ajustes opcionales del dominio principal (lideratech.ar)
#
# Cómo usarlo: subí este archivo al document root del hosting que sirve
# lideratech.ar, renombrado exactamente como ".htaccess" (sin extensión).
#
# Qué hace:
#   1. fuerza HTTPS (si el hosting sirve http sin redirigir por su cuenta)
#   2. cachea los estáticos con versionado por query string
#
# Si el panel de Donweb ya fuerza HTTPS y gestiona el cache, no hace falta
# subirlo.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://lideratech.ar%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
